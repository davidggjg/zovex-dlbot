# ===== חובה =====
# מ-@BotFather
BOT_TOKEN=123456:AA...

# ה-user id שלך בטלגרם (מ-@userinfobot). מופרד בפסיקים אם כמה אדמינים.
ADMIN_IDS=123456789

# ===== Local Bot API Server (מה שמאפשר 2GB) =====
# אם השרת המקומי מותקן - השאר true. אם לא - false (ואז המגבלה 50MB)
USE_LOCAL_API=true
LOCAL_API_URL=http://127.0.0.1:8081

# ===== מגבלות (פתוח לכולם) =====
MAX_FILESIZE_MB=1950           # תקרת טלגרם היא 2000MB
DAILY_QUOTA_MB=4000            # נפח יומי לכל משתמש
DAILY_JOBS=25                  # מספר הורדות יומי לכל משתמש
GLOBAL_CONCURRENCY=2           # כמה הורדות במקביל בכל השרת (2 ליבות -> 2)
USER_CONCURRENCY=1             # כמה הורדות במקביל לכל משתמש
COOLDOWN_SECONDS=3             # מרווח מינימלי בין בקשות
MAX_DURATION_MINUTES=240       # אורך וידאו מקסימלי
ALLOW_PLAYLISTS=false

# ===== נתיבים =====
DOWNLOAD_DIR=/var/lib/dlbot/downloads
DATA_DIR=/var/lib/dlbot
COOKIES_DIR=/var/lib/dlbot/cookies

# ===== התנהגות =====
DEFAULT_SUB_LANGS=he,en        # שפות שיוצגו ראשונות ברשימת הכתוביות
PROGRESS_INTERVAL=4            # כל כמה שניות לעדכן את שורת ההתקדמות
